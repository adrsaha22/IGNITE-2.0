# IGNITE 2.0 — backend environment configuration.
#
# Copy to `.env` and fill in your own values:
#     cp .env.example .env
#
# NEVER commit a real API key. `.env` is git-ignored.

# ------------------------------------------------------- Generation mode
#
# gemini (default) — rules are generated from your scenario by the LLM.
# demo             — offline, pre-written templates for demonstrating the app
#                    without a provider or quota.
#
# Demo mode is intentionally narrow. It covers only PowerShell download
# cradles, certutil transfers and scheduled-task persistence. Any other
# scenario returns ZERO candidates with an explanation, rather than an
# unrelated rule presented as a detection.
#
# Demo output is labelled DEMO / template-based everywhere it appears. It is
# never described as LLM-generated or Splunk-validated.
DETECTION_GENERATION_MODE=gemini

# ------------------------------------------------------------ AI provider
#
# Which provider generates rules and powers the Assistant:
#   gemini    (default) Google Gemini — set GEMINI_API_KEY below
#   anthropic Claude — set ANTHROPIC_API_KEY
#   openai    OpenAI or an OpenAI-compatible gateway (Azure) — set OPENAI_API_KEY
#   ollama    a local model server; prompts never leave your network
#   ellm      your own LLM behind an OpenAI-compatible endpoint
IGNITE_LLM_PROVIDER=gemini

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=
# OLLAMA_MODEL=llama3.1
# ELLM — your own LLM behind an OpenAI-compatible endpoint (base URL usually ends in /v1)
# ELLM_BASE_URL=
# ELLM_MODEL=
# ELLM_API_KEY=

# ---------------------------------------------------------------- AI Detection Assistant
#
# Optional. Without it, everything except the AI Detection Assistant still works:
# rule generation, the Testing Lab, validation, ATT&CK mapping, saved
# investigations and exports are all fully offline.
#
# Get a key:
#   1. Sign in at https://aistudio.google.com/
#   2. Open "Get API key" and create one
#   3. Paste it below
#
# PRIVACY: free-tier requests may be used by the provider to improve their
# services. Review Google's current terms before sending real organisational
# telemetry. IGNITE sends only the attack scenario, the selected rule,
# validation findings and ATT&CK mappings — never credentials or raw logs.
GEMINI_API_KEY=

# Model ID. Provider catalogues change, so this is configurable.
# Verify current free-tier models at https://ai.google.dev/gemini-api/docs/models
# "gemini-flash-latest" tracks the current stable Flash model and is a
# good default. Pin a specific ID if you need reproducibility.
GEMINI_MODEL=gemini-flash-latest

# Override only if you use a proxy or a regional endpoint.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Request bounds — keep free-tier quota use predictable.
# IGNITE_LLM_MAX_OUTPUT_TOKENS=1200
# IGNITE_LLM_MAX_INPUT_CHARS=12000
# IGNITE_LLM_CONNECT_TIMEOUT=5
# IGNITE_LLM_READ_TIMEOUT=45

# ------------------------------------------------------------- Persistence
#
# SQLite file holding saved investigations.
# IGNITE_DB_PATH=data/investigations.db

# ------------------------------------------------------- Legacy AI summary
#
# The original local-model summary panel, separate from the Assistant.
# OLLAMA_BASE_URL=http://localhost:11434

# --------------------------------------------------------------------- CORS
#
# Origins permitted to call the API.
# IGNITE_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------------------------------------------------------- Quality gates
#
# How many times failing quality checks are sent back to the model for
# repair. Each repair is one extra provider request.
# IGNITE_MAX_REPAIR_ATTEMPTS=2
# A test search returning this many events or more is flagged as noisy.
# IGNITE_NOISY_THRESHOLD=50

# ----------------------------------------------------------------- Splunk
#
# Optional. Enables Splunk parser validation, test searches and deployment
# of approved rules. Use the management port (8089), not the web port.
# Create a token under Settings > Tokens in Splunk. The token stays on the
# server and is never sent to the browser.
# SPLUNK_URL=https://splunk.example.com:8089
# SPLUNK_TOKEN=
# (or) SPLUNK_USERNAME= / SPLUNK_PASSWORD=
# SPLUNK_APP=search
# SPLUNK_OWNER=nobody
# Leave on. Set false only for a local test instance with a self-signed cert.
# SPLUNK_VERIFY_SSL=true

# --------------------------------------------------------- Knowledge base
#
# Reference detections retrieved to ground generation. Built by
# scripts/download_sources.py + scripts/build_dataset.py.
# IGNITE_KNOWLEDGE_DIR=data/knowledge
# IGNITE_RETRIEVAL_TOP_K=3
# Sigma corpus for the legacy template pipeline (defaults to the SigmaHQ download).
# IGNITE_SIGMA_PATH=

# ------------------------------------------------------------- Governance
#
# Name recorded in the audit log for saves, reviews and deployments. There is
# no login yet; defaults to the OS user running the API.
# IGNITE_OPERATOR=
# Minimum length of the justification needed to approve a failing rule.
# IGNITE_OVERRIDE_MIN_CHARS=20
