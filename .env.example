# IGNITE 2.0 — backend environment configuration.
#
# Copy to `.env` and fill in your own values:
#     cp .env.example .env
#
# NEVER commit a real API key. `.env` is git-ignored.

# ------------------------------------------------------- Generation mode
#
# gemini (default) — rules are generated from your scenario by the LLM.
# demo             — offline, pre-written templates for demonstrating the app
#                    without a provider or quota.
#
# Demo mode is intentionally narrow. It covers only PowerShell download
# cradles, certutil transfers and scheduled-task persistence. Any other
# scenario returns ZERO candidates with an explanation, rather than an
# unrelated rule presented as a detection.
#
# Demo output is labelled DEMO / template-based everywhere it appears. It is
# never described as LLM-generated or Splunk-validated.
DETECTION_GENERATION_MODE=gemini

# ---------------------------------------------------------------- AI Copilot
#
# Optional. Without it, everything except the AI Copilot still works:
# rule generation, the Testing Lab, validation, ATT&CK mapping, saved
# investigations and exports are all fully offline.
#
# Get a key:
#   1. Sign in at https://aistudio.google.com/
#   2. Open "Get API key" and create one
#   3. Paste it below
#
# PRIVACY: free-tier requests may be used by the provider to improve their
# services. Review Google's current terms before sending real organisational
# telemetry. IGNITE sends only the attack scenario, the selected rule,
# validation findings and ATT&CK mappings — never credentials or raw logs.
GEMINI_API_KEY=

# Model ID. Provider catalogues change, so this is configurable.
# Verify current free-tier models at https://ai.google.dev/gemini-api/docs/models
# "gemini-flash-latest" tracks the current stable Flash model and is a
# good default. Pin a specific ID if you need reproducibility.
GEMINI_MODEL=gemini-flash-latest

# Override only if you use a proxy or a regional endpoint.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Request bounds — keep free-tier quota use predictable.
# IGNITE_LLM_MAX_OUTPUT_TOKENS=1200
# IGNITE_LLM_MAX_INPUT_CHARS=12000
# IGNITE_LLM_CONNECT_TIMEOUT=5
# IGNITE_LLM_READ_TIMEOUT=45

# ------------------------------------------------------------- Persistence
#
# SQLite file holding saved investigations.
# IGNITE_DB_PATH=data/investigations.db

# ------------------------------------------------------- Legacy AI summary
#
# The original local-model summary panel, separate from the Copilot.
# OLLAMA_BASE_URL=http://localhost:11434

# --------------------------------------------------------------------- CORS
#
# Origins permitted to call the API.
# IGNITE_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
